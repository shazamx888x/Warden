# Copy to .env and fill in only if you run the real Cloudflare backend
# (chapters 15 onward). The offline chapters need none of this.

# Cloudflare account and an API token with Workers AI and Vectorize access.
CF_ACCOUNT_ID=your-account-id
CF_API_TOKEN=your-api-token

# Optional overrides (defaults come from src/warden/constants.py):
# CF_CHAT_MODEL=@cf/zai-org/glm-4.7-flash
# CF_VECTORIZE_INDEX=warden-hr-index

# The Prompt Guard 2 service on your Oracle VM (control W2):
# PROMPT_GUARD_URL=http://your-vm-ip:8088/score

# The backend to use. Leave unset for the offline simulator.
# WARDEN_BACKEND=cloudflare
